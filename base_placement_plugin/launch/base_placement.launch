<?xml version="1.0"?>
<launch>

    <arg name = "fixed_frame" default="odom" doc="fixed frame for the base placement usually corresponds to the parent of the virtual joint of the robot"/>
    <arg name = "bp_results" default="false"/>
    <arg name = "OGM2d_filtering" default="true"/>
    <arg name = "OGM2d_topic" default="/move_base/global_costmap/costmap"/>
    <arg name = "OGM2d_cost_threshold" default="70"/>
    <arg name = "TIAGO_torso_filtering" default="true"/>

    <param name="BPP_fixed_frame" value="$(arg fixed_frame)" />

    <!--PARAMETERS FOR THE FILTERING of the union map - used within sphere_discretization::associatePose-->
    <param name="TIAGO_torso_filtering" value="$(arg TIAGO_torso_filtering)"/>
    
    <param name="OGM2d_filtering" value="$(arg OGM2d_filtering)"/>
    <group if="$(arg OGM2d_filtering)">
        <param name="OGM2d_topic" value="$(arg OGM2d_topic)"/>
        <param name="cost_threshold" value="$(arg OGM2d_filtering)"/>
    </group>

    <!--Running RVIZ for base_placement-->
    <node pkg="rviz" type="rviz" output="screen" name="BPP_rviz_plugin" args="-d $(find base_placement_plugin)/rviz/base_placement.rviz" />

    <node pkg="reule_aux" type="move_to_bp_result_TIAGO" output="screen" name="move_to_bp_result_TIAGO" if="$(arg bp_results)" />
    <!--node pkg="reule_aux" type="move_to_bp_result" output="screen" name="move_to_bp_result" if="$(arg bp_results)" /-->


</launch>
