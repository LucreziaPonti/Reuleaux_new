<?xml version="1.0"?>
<launch>

    <arg name = "fixed_frame" default="odom" doc="fixed frame for the base placement usually corresponds to the parent of the virtual joint of the robot / the root of the robot"/>
    <arg name = "bp_results" default="false"/>
    

    <param name="BPP_fixed_frame" value="$(arg fixed_frame)" />

    <!--Running RVIZ for base_placement-->
    <node pkg="rviz" type="rviz" output="screen" name="BPP_rviz_plugin" args="-d $(find base_placement_plugin)/rviz/base_placement.rviz" />

    <!--node pkg="reule_aux" type="reuleaux_bp_to_nav" output="screen" name="reuleaux_bp_to_nav" if="$(arg bp_results)" /-->


</launch>
