<?xml version="1.0"?>
    <launch>

    <!--*********ADJUST DEPENDING ON THE ROBOT YOU WANT TO USE!!*******-->
    <arg name = "use_IKFast" default="false"/>
    <arg name = "fixed_frame" default="world"/>
    <arg name="bp_results" default="false"/>

    <!--PARAMETERS FOR THE FILTERING of the union map - used within map_generator>discretization::associatePose-->
    <arg name = "IKValid_filtering" default="true"/>
    
    <arg name = "OCTOMAP_SRV_filtering" default="false"/>
    
    <arg name = "OCTOMAP_PS_filtering" default="true"/> 

    <arg name="OGM2d_filtering" default="false"/>
    <arg name = "OGM2d_topic" default="/move_base/global_costmap/costmap"/>
    <arg name = "OGM2d_cost_threshold" default="60"/>
    
    <arg name="TIAGO_torso_filtering" default="false"/>

    <!--*********ADJUST DEPENDING ON THE ROBOT YOU WANT TO USE!!*******-->
    <!--ROBOTS USED: rm_63_b_moveit_config  -  tiago_moveit_config   -->
    <include file="$(find rm_63_b_moveit_config)/launch/demo.launch"> 
        <arg name="use_rviz" value="true"/>  
    </include>

    <!--Running RVIZ for base_placement-->
    <include file="$(find base_placement_plugin)/launch/base_placement.launch">
        <arg name="use_IKFast" value="$(arg use_IKFast)"/>
        <arg name="bp_results" value="$(arg bp_results)"/>   
        <arg name="fixed_frame" value="$(arg fixed_frame)"/>
        <arg name="IKValid_filtering" value="$(arg IKValid_filtering)"/>
        <arg name="OCTOMAP_SRV_filtering" value="$(arg OCTOMAP_SRV_filtering)"/>
        <arg name="OCTOMAP_PS_filtering" value="$(arg OCTOMAP_PS_filtering)"/>
        <arg name="OGM2d_filtering" value="$(arg OGM2d_filtering)"/>
        <arg name="OGM2d_topic" value="$(arg OGM2d_topic)"/>
        <arg name="OGM2d_cost_threshold" value="$(arg OGM2d_cost_threshold)"/>
        <arg name="TIAGO_torso_filtering" value="$(arg TIAGO_torso_filtering)"/>
    </include>


</launch>
