<?xml version="1.0"?>
<launch>

<!--Launch moveit required pkgs for your robot-->
<include file="$(find tiago_moveit_config)/launch/demo.launch">
    <arg name="use_rviz" value="false"/>
</include>

<node name="rviz" pkg="rviz" type="rviz" args="-d $(find map_generator)/config/visualize_maps.rviz" />


</launch>
